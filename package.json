{
  "name": "radio-ibiza-player-4",
  "version": "4.0.0",
  "ibizaShellVersion": "4.0.0054",
  "ibizaShellVersionMobile": "4.0.0054",
  "homepage": "https://player4.radioibiza.com.br",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "main": "electron/main.mjs",
  "description": "Player Radio Ibiza moderno (PWA + Electron) — comunica com webservice legado",
  "author": "Radio Ibiza",
  "scripts": {
    "dev": "vite",
    "dev:shell-mobile": "VITE_IBIZA_DEV_FORCE_TOUCH_SHELL=1 vite",
    "build": "tsc -b && vite build",
    "build:web": "tsc -b && vite build --mode production",
    "build:player5": "node scripts/assert-player-5-api.mjs && cross-env VITE_IBIZA_TARGET=5 npm run build",
    "build:win": "npm run generate-icons:desktop && npm run generate-installer-win-assets && node scripts/ensure-ti-win-build.mjs && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false VITE_IBIZA_TARGET=W npm run build && node scripts/assert-win-build.mjs && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win --x64 --publish never",
    "build:win-loja:dir": "npm run generate-icons:desktop && node scripts/stage-loja-pack-flag.mjs on && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false VITE_IBIZA_TARGET=W VITE_VIDEO_BRIDGE=1 npm run build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win --x64 --dir --config electron-builder-loja.json --publish never && node scripts/stage-loja-pack-flag.mjs off",
    "dist:win": "npm run build:win",
    "stage:win-installer": "node scripts/stage-windows-installer.mjs",
    "preview": "vite preview",
    "generate-icons": "node scripts/generate-pwa-icons.mjs",
    "generate-icons:desktop": "node scripts/generate-desktop-icons.mjs",
    "generate-installer-win-assets": "node scripts/generate-nsis-installer-assets.mjs",
    "backup:zip": "bash scripts/criar-backups-zip.sh",
    "backup:zip:leve": "BACKUP_LEVE=1 bash scripts/criar-backups-zip.sh",
    "lint": "eslint . --ext ts,tsx",
    "lint:shells": "node scripts/check-shell-imports.mjs",
    "electron:open": "electron ./electron/main.mjs",
    "electron:dev": "VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron ./electron/main.mjs",
    "electron:build": "npm run build && electron ./electron/main.mjs"
  },
  "dependencies": {
    "@netlify/blobs": "^10.7.7",
    "clsx": "^2.1.1",
    "dexie": "^4.0.10",
    "dexie-react-hooks": "^1.1.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.27.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.0.0",
    "autoprefixer": "^10.4.20",
    "cross-env": "^10.1.0",
    "electron": "^34.2.0",
    "electron-builder": "^26.8.1",
    "png-to-ico": "^3.0.1",
    "postcss": "^8.4.47",
    "rcedit": "^4.0.1",
    "sharp": "^0.33.5",
    "tailwindcss": "^3.4.14",
    "typescript": "~5.6.3",
    "vite": "^8.0.13",
    "vite-plugin-pwa": "^1.3.0"
  },
  "build": {
    "appId": "com.radioibiza.player",
    "productName": "Radio Ibiza",
    "copyright": "© Radio Ibiza",
    "directories": {
      "output": "dist-electron",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "dist/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "electron/preload.mjs"
    ],
    "extraResources": [
      {
        "from": "build/icon.ico",
        "to": "RadioIbiza.ico"
      },
      {
        "from": "build/corrigir-permissoes-multiusuario.bat",
        "to": "corrigir-permissoes-multiusuario.bat"
      },
      {
        "from": "build/diagnostico-multiusuario.bat",
        "to": "diagnostico-multiusuario.bat"
      },
      {
        "from": "build/onde-esta-o-login.bat",
        "to": "onde-esta-o-login.bat"
      },
      {
        "from": "build/setup-programdata-acl.ps1",
        "to": "setup-programdata-acl.ps1"
      },
      {
        "from": "build/programdata-sessao-inicial.json",
        "to": "programdata-sessao-inicial.json"
      },
      {
        "from": "build/programdata-configs-inicial.json",
        "to": "programdata-configs-inicial.json"
      }
    ],
    "afterPack": "./scripts/after-pack-win-icon.mjs",
    "win": {
      "requestedExecutionLevel": "asInvoker",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "RadioIbiza-${version}-W-Setup.${ext}",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true,
      "menuCategory": "Radio Ibiza",
      "shortcutName": "Radio Ibiza",
      "runAfterFinish": false,
      "deleteAppDataOnUninstall": true,
      "license": "build/licenca-instalador.txt",
      "language": "1046",
      "installerLanguages": [
        "pt_BR"
      ],
      "multiLanguageInstaller": false,
      "displayLanguageSelector": false,
      "installerIcon": "build/icon.ico",
      "installerHeader": "build/installerHeader.bmp",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallDisplayName": "Radio Ibiza Player ${version}",
      "include": "build/installer.nsh"
    }
  }
}
