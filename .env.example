# -----------------------------------------------------------------------------
# Produção (`npm run build` / CI)
#
# Copie para `.env.production` na raiz (Vite carrega automaticamente no build)
# ou defina no painel da hospedagem (Netlify/Vercel/Cloudflare Pages, etc.).
#
# Sem variável ou com URL HTTPS completa → browser chama cloud direto; aí é
# preciso CORS no servidor PHP (deploy/cors-snippet.exemplo.txt).
#
# Valor apenas "/api" → reverse proxy na hospedagem (o netlify.toml do repo já
# define isso para build no Netlify; não define em .env.local se usar outra URL).
# -----------------------------------------------------------------------------

VITE_WEBSERVICE_URL=https://cloud.radioibiza.com.br/services/webservice

# Teste (logs [ibiza-rede] + botão «Copiar diagnóstico»):
# - .env: VITE_DEBUG_REDE=1 no build, ou
# - na própria app: URL ?debug_rede=1 ou localStorage key radio_ibiza_debug_rede=1 (sem rebuild)
# VITE_DEBUG_REDE=1

# -----------------------------------------------------------------------------
# Avisos operador (mensagens vermelhas no player)
#
# Player: GET público em `/.netlify/functions/player-avisos` (sem credenciais).
# Opcional no build Vite:
# - VITE_PLAYER_PUBLIC_ORIGIN — origem do PWA (Electron com file:// aponta aqui)
# - VITE_PLAYER_AVISOS_DISABLED=1 — desliga o fetch de avisos
#
# Admin (só Netlify Functions, não são VITE_*):
# - IBIZA_AVISOS_ADMIN_EMAIL
# - IBIZA_AVISOS_ADMIN_PASSWORD
# Definir no painel Netlify (Site settings → Environment variables).
# Requer Netlify Blobs ativo no site para persistir mensagens.
# -----------------------------------------------------------------------------
